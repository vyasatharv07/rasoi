# Application
PORT=4000
APP_URL=http://localhost:5173
NODE_ENV=development
DATABASE_PATH=./data/rasoi.db

# Generate long random secrets in production (at least 32 characters each)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

# Receipt and daily digest mail. If omitted, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rasoi Kitchen <orders@example.com>
ADMIN_DIGEST_EMAIL=admin@example.com

# Daily digest schedule (default: 6:00 PM, server timezone)
DIGEST_CRON=0 18 * * *
TAX_RATE=0.0825

# Firebase Authentication — create a Web app in Firebase Console and enable
# Authentication > Sign-in method > Email/Password. VITE_ values are public
# Firebase identifiers and are bundled into the browser app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin credentials. In local development, copy these from
# a service-account JSON key. Keep the private key quoted with escaped newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
