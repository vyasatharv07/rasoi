{
  "name": "rasoi-order-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty && tsc --noEmit -p tsconfig.node.json --pretty"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.536.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.33",
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.6"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
